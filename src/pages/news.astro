---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const news = [
    ['29.12.2021', 'Проведен ремонт футеровки вращающейся печи на ОАО «Русский Хром».'],
    ['29.12.2021', 'Проведен капитальный ремонт секционных печей № 2 и 3 в цехе 8 АО «ПНТЗ» г. Первоуральск.'],
    ['12.10.2021', 'Проведен капитальный ремонт обжиговой машины № 4 на Качканарском ГОКе АО «ЕВРАЗ КГОК».'],
    ['29.06.2021', 'Проведен ремонт футеровок реакторов и печей производства бутадиена на ООО «СИБУР Тобольск» ЗапСибНефтехим.'],
    ['22.05.2021', 'Проведен текущий ремонт методических печей ТПУ-220 и ТПУ-140 в цехе № 1 АО «ПНТЗ».'],
    ['30.01.2020', 'Заключен долговременный договор на ремонты печей АО «Катавский цемент» Евроцемент Групп.'],
    ['30.11.2019', 'Проведен ремонт футеровки вращающейся печи цеха «Обжиг» ООО «Староцементный завод» г. Сухой Лог.'],
    ['05.11.2019', 'Заключены договоры с ПАО «ЧТПЗ» и проведена модернизация шахтного закалочного аппарата ШЗА.'],
    ['03.04.2019', 'Проведен ремонт футеровки и нагревателей электрической шахтной печи ПШО 10.15/7И1 на ПАО «МЗИК».'],
    ['06.02.2019', 'Спроектирована, изготовлена и смонтирована керамоволокнистая футеровка газовой проходной роликовой печи ПАО «СИНТЗ».'],
    ['30.11.2018', 'Проведены работы по теплоизоляции газоходов и корпусов фильтров мельниц ООО «Староцементный завод».'],
    ['16.06.2018', 'Произведена поставка 42 нагревательных элементов из фехрали на ПАО «МЗИК».'],
    ['14.05.2018', 'Проводится монтаж электрической нагревательной печи на ОКБ «Новатор» в Екатеринбурге.'],
    ['06.04.2018', 'Завершены работы по футеровке газохода и литейного двора доменной печи № 7 НТМК.'],
    ['28.09.2017', 'Выигран тендер ОКБ «Новатор» на изготовление и монтаж электрической печи с выкатным подом.'],
];
---

<Base title="Новости и кейсы — РПК" description="Новости, выполненные работы и проекты ООО «РПК».">
    <PageHero kicker="Новости и кейсы" title="Работа компании по годам" lead="Собрали выполненные работы и новости со старого сайта в одном разделе." />
    <section class="section section-light"><div class="container"><div class="project-grid">{news.map(([date, title]) => <article class="project-card"><span class="project-date">{date}</span><h3>{title}</h3></article>)}</div></div></section>
</Base>
