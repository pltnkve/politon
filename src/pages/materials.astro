---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Производство материалов — Политон" description="Производство нагревательных элементов и огнеупорных изделий.">
    <PageHero kicker="Производство материалов" title="Материалы для высоких температур" lead="Производим и поставляем элементы, которые работают внутри теплового агрегата." />
    <section class="section section-light"><div class="container"><div class="section-heading"><div><p class="kicker">Номенклатура</p><h2>Изготавливаем по расчёту и чертежам</h2></div><p>Подбираем, рассчитываем и производим материалы для конкретной печи и способа крепления.</p></div><div class="content-grid"><article class="feature-card"><h2>Электронагреватели</h2><p>Нагревательные элементы из нихрома и фехрали по расчёту или чертежам заказчика.</p><a class="text-link" href="/materials/heaters/">Подробнее</a></article><article class="feature-card"><h2>Формованные изделия</h2><p>Горелочные блоки, брус, фасонные изделия и керамические детали.</p><a class="text-link" href="/materials/shaped-refractories/">Подробнее</a></article><article class="feature-card"><h2>Модули МТ</h2><p>Керамоволокнистые модули — аналог Z-блоков для снижения теплопотерь.</p><a class="text-link" href="/materials/mt-modules/">Подробнее</a></article><article class="feature-card"><h2>Анкеры и токовводы</h2><p>Анкерные крепления из жаропрочной стали и элементы для нагревателей.</p><a class="text-link" href="/materials/anchors/">Подробнее</a></article><article class="feature-card"><h2>Легковесные огнеупоры</h2><p>Материалы для лёгких и энергоэффективных конструкций футеровки.</p><a class="text-link" href="/materials/lightweight-refractories/">Подробнее</a></article></div></div></section>
    <section class="section"><div class="container split"><div class="split-copy"><p class="kicker">Под заказ</p><h2>Соберём комплект под ваш агрегат</h2><p>Уточним размеры, режим нагрева и условия эксплуатации, после чего подготовим состав поставки и сроки изготовления.</p><ul class="check-list"><li>Подбор материала и типоразмера</li><li>Расчёт потребности</li><li>Комплектация и упаковка</li><li>Доставка по УрФО</li></ul></div><div class="split-media"></div></div></section>
</Base>
