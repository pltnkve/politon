import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Футеровочные работы — Политон" description="Проектирование, ремонт футеровок и шеф-монтаж тепловых агрегатов.">
    <PageHero kicker="Футеровочные работы" title="Продлеваем ресурс тепловых агрегатов" lead="ООО «ПО-Политон» оказывает услуги по футеровке тепловых агрегатов. Работаем по чертежам заказчика либо по конструкторской документации собственной разработки." />
    <section class="section section-light"><div class="container"><div class="section-heading"><div><p class="kicker">Полный цикл</p><h2>Проектирование и проведение футеровочных работ</h2></div><p>Располагаем высококвалифицированным персоналом и необходимым оборудованием для ремонта тепловых агрегатов.</p></div><div class="content-grid"><article class="feature-card"><h2>Подбор огнеупоров</h2><p>Выбираем материалы под температуру, среду и конструкцию агрегата.</p><a class="text-link" href="/refractories/">Подробнее</a></article><article class="feature-card"><h2>Проектирование</h2><p>Разрабатываем проект и дизайн футеровки, проводим экспертизу на промбезопасность.</p><a class="text-link" href="/lining/design/">Подробнее</a></article><article class="feature-card"><h2>Монтаж</h2><p>Поставляем материалы и выполняем футеровочные работы на объекте.</p><a class="text-link" href="/lining/work/">Подробнее</a></article></div></div></section>
    <section class="section"><div class="container prose"><h2>Выполняем все виды футеровочных работ</h2><p>Футеровка — внутренняя или внешняя облицовка печей, ковшей, труб, котлов, газоходов и других элементов теплоизоляционными и огнеупорными материалами.</p><ul><li>кладка огнеупорным кирпичом и блоками;</li><li>футеровка рулонными материалами и керамоволокнистыми модулями;</li><li>торкретирование и футеровка бетонами;</li><li>изготовление и монтаж опалубки;</li><li>нанесение специальных огнеупорных покрытий;</li><li>изготовление и сушка нестандартных изделий;</li><li>конструктивная резка огнеупорных изделий.</li></ul><a class="button" href="/contacts/">Получить консультацию</a></div></section>
</Base>
