---
import Base from '../layouts/Base.astro';

const services = [
    { title: 'Проектирование промышленных печей', summary: 'Расчёт, подбор огнеупоров и разработка технической документации.', href: '/industrial-furnaces/' },
    { title: 'Футеровочные работы', summary: 'Ремонт футеровок тепловых агрегатов, монтаж и шеф-монтаж.', href: '/lining/' },
    { title: 'Производство материалов', summary: 'Электронагреватели, фехраль, нихром, модули МТ и огнеупорные изделия.', href: '/materials/' },
    { title: 'Строительство промышленных печей', summary: 'Изготовление, монтаж и пусконаладка нагревательных печей.', href: '/industrial-furnaces/construction/' },
    { title: 'АСУТП', summary: 'Проектирование, изготовление и монтаж систем автоматизации.', href: '/industrial-furnaces/automation/' },
    { title: 'Огнеупорные материалы', summary: 'Подбор и поставка материалов для высокотемпературных агрегатов.', href: '/refractories/' },
];
const projects = [
    { year: '2021', title: 'Русский Хром — ремонт футеровки вращающейся печи' },
    { year: '2019', title: 'Евроцемент Групп — ремонт вращающейся печи' },
    { year: '2018', title: 'ПАО «СИНТЗ» — футеровка газовой печи' },
];
const description = 'ООО «РПК» — Русская Печная Компания: проектирование и ремонт футеровок, промышленных печей, АСУТП и производство огнеупорных материалов в Екатеринбурге и по УрФО.';
---

<Base title="РПК — промышленные печи и футеровка" description={description}>
    <section class="hero">
        <div class="container hero-content">
            <p class="eyebrow">Промышленная теплоизоляция · Екатеринбург</p>
            <h1>Тепло работает на результат</h1>
            <p class="hero-lead">Услуги по проектированию и ремонту футеровок тепловых агрегатов с последующим гарантийным и сервисным обслуживанием.</p>
            <div class="hero-actions">
                <a class="button" href="#contact">Обсудить задачу</a>
                <a class="hero-phone" href="tel:+73433834407">+7 (343) 383-44-07</a>
            </div>
            <div class="hero-meta">
                <div><strong>30+</strong><span>лет инженерной экспертизы</span></div>
                <div><strong>УрФО</strong><span>география работы</span></div>
                <div><strong>360°</strong><span>от проекта до сервиса</span></div>
            </div>
        </div>
    </section>

    <section class="section section-light" id="services">
        <div class="container">
            <div class="section-heading">
                <div><p class="kicker">Что мы делаем</p><h2>Промышленная теплоизоляция под задачу</h2></div>
                <p>Рассчитываем теплоизоляцию, разрабатываем техническую документацию и выполняем работы по чертежам заказчика или собственной разработке.</p>
            </div>
            <div class="service-grid">
                {services.map((service, index) => (
                    <article class="service-card">
                        <span class="service-index">0{index + 1}</span>
                        <h3>{service.title}</h3>
                        <p>{service.summary}</p>
                        <a class="text-link" href={service.href}>Подробнее</a>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container split">
            <div class="split-media" role="img" aria-label="Промышленное производство и тепловые агрегаты"></div>
            <div class="split-copy">
                <p class="kicker">Полный цикл</p>
                <h2>От расчёта теплоизоляции до сервисного обслуживания</h2>
                <p>На своей производственной площадке в Екатеринбурге изготавливаем теплоизоляционные модули и изделия из огнеупорных бетонов.</p>
                <ul class="check-list">
                    <li>Ремонт футеровок тепловых агрегатов своими силами</li>
                    <li>Подбор огнеупоров и разработка инженерной документации</li>
                    <li>Конструирование, изготовление и монтаж промышленных печей</li>
                </ul>
            </div>
        </div>
    </section>

    <section class="section section-light" id="projects">
        <div class="container">
            <div class="section-heading">
                <div><p class="kicker">Опыт в деле</p><h2>Проекты, где важна каждая степень</h2></div>
                <a class="text-link" href="/projects/">Все проекты</a>
            </div>
            <div class="project-grid">
                {projects.map((project) => (
                    <article class="project-card">
                        <span class="project-date">{project.year}</span>
                        <h3>{project.title}</h3>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="section contact-section" id="contact">
        <div class="container contact-grid">
            <div><p class="kicker">Есть задача?</p><h2 class="contact-title">Обсудим агрегат, сроки и решение.</h2></div>
            <div class="contact-details">
                <p>Екатеринбург, пер. Автоматики, 2е<br />Работаем по УрФО</p>
                <a href="tel:+73433834407">+7 (343) 383-44-07</a>
                <a href="mailto:rpk-67@yandex.ru">rpk-67@yandex.ru</a>
                <a class="button" href="mailto:rpk-67@yandex.ru?subject=Задача%20для%20РПК">Написать нам</a>
            </div>
        </div>
    </section>
</Base>
