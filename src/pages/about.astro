---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="О компании — Политон" description="ООО «Политон» — инженерные решения для промышленных тепловых агрегатов.">
    <PageHero kicker="О компании" title="Инженерная команда для сложных тепловых задач" lead="ООО «ПО-Политон» оказывает услуги по проектированию и ремонту футеровок тепловых агрегатов с последующим гарантийным и сервисным обслуживанием." />
    <section class="section section-light"><div class="container split"><div class="split-copy"><p class="kicker">О компании</p><h2>Работаем с промышленными предприятиями</h2><p>Специалисты компании выполняют монтаж высокотемпературной теплоизоляции и берут на себя вопросы, связанные с сервисным обслуживанием. Работаем по всей территории УрФО.</p><ul class="check-list"><li>Собственный штат огнеупорщиков</li><li>Необходимое оборудование и инструмент</li><li>Работа по чертежам заказчика</li><li>Собственная конструкторская документация</li></ul></div><div class="split-media"></div></div></section>
    <section class="section"><div class="container"><div class="section-heading"><div><p class="kicker">История работ</p><h2>Результаты и новости компании</h2></div><p>Выполненные проекты и рабочие новости перенесены из старого сайта в отдельные разделы.</p></div><a class="button" href="/news/">Смотреть новости и кейсы</a></div></section>
</Base>
